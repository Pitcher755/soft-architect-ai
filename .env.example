# ═══════════════════════════════════════════════════════════════
# SoftArchitect AI - Master Configuration Template
#
# INSTRUCCIONES:
# 1. Copia este archivo como .env en la misma carpeta raíz
# 2. Rellena tus API Keys y ajusta los recursos de tu PC
# 3. Este archivo (.example) SÍ se sube a GitHub. El .env NO.
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# 0. GLOBAL APP SETTINGS
# ─────────────────────────────────────────────────────────────
PROJECT_NAME="SoftArchitect AI"
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
# 1. DOCKER RESOURCES & IMAGES
# ─────────────────────────────────────────────────────────────
PYTHON_VERSION=3.12.3
OLLAMA_IMAGE_VERSION=latest
CHROMADB_IMAGE_VERSION=latest

# Ajusta según tu RAM. (2GB a 4GB para Ollama si usas LLMs locales)
OLLAMA_MEMORY_LIMIT=2GB
OLLAMA_CPU_SHARES=1024
CHROMADB_MEMORY_LIMIT=512MB
API_MEMORY_LIMIT=512MB

# ─────────────────────────────────────────────────────────────
# 2. LLM PROVIDER SELECTION
# ─────────────────────────────────────────────────────────────
# Opciones válidas: 'gemini', 'groq', 'ollama'
LLM_PROVIDER=gemini

# ─────────────────────────────────────────────────────────────
# 3. GEMINI CONFIGURATION (Cloud - Default)
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# ─────────────────────────────────────────────────────────────
# 4. OLLAMA CONFIGURATION (Local/Offline)
# ─────────────────────────────────────────────────────────────
# Modelos recomendados: qwen2.5-coder:7b, llama3.2, phi4-mini
OLLAMA_MODEL=llama3.2
# URL interna para Docker
OLLAMA_BASE_URL=http://ollama:11434

# ─────────────────────────────────────────────────────────────
# 5. GROQ CONFIGURATION (Cloud - Fast)
# ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────────────────────────
# 6. VECTOR DB (ChromaDB)
# ─────────────────────────────────────────────────────────────
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
CHROMADB_DATA_PATH=/data/chromadb

# ─────────────────────────────────────────────────────────────
# 7. RAG & CONTEXT LIMITS (Advanced Tuning)
# ─────────────────────────────────────────────────────────────
# Límite de caracteres del prompt (Tokens * 4).
# Gemini/Groq: 200000. Ollama local (8K context): 30000.
LLM_MAX_PROMPT_CHARS=200000

# Fragmentos de contexto recuperados por documento.
# Gemini/Groq: 3 a 5. Ollama local: 2.
RAG_MAX_CHUNKS=3

# ─────────────────────────────────────────────────────────────
# 8. PRIVACY, SECURITY & MEMORY
# ─────────────────────────────────────────────────────────────
IRON_MODE=True
PII_DETECTION_ENABLED=True

# Límite de mensajes en el historial para evitar saturación
CHAT_MAX_HISTORY_MESSAGES=50
CHAT_MAX_MESSAGE_LENGTH=20000
