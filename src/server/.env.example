# ═══════════════════════════════════════════════════════════════
# SoftArchitect AI - Backend Environment Configuration Template
#
# INSTRUCCIONES:
# 1. Copiar este archivo a .env: cp .env.example .env
# 2. Rellenar los valores según tu entorno
# 3. NUNCA commitear .env a Git (incluido en .gitignore)
# 4. Valores por defecto funcionan para desarrollo local
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# APP CONFIGURATION
# ─────────────────────────────────────────────────────────────
APP_NAME=SoftArchitect AI
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────
# API CONFIGURATION
# ─────────────────────────────────────────────────────────────
API_V1_STR=/api/v1
API_PORT=8000

# ─────────────────────────────────────────────────────────────
# LLM PROVIDER SELECTION
# ─────────────────────────────────────────────────────────────
# Opciones: "local" (Ollama - Privado, Offline)
#           "cloud" (Groq - Rápido, Requiere API Key)
#
# 🔒 MODO LOCAL (Recomendado para Privacidad):
#    - Usa Ollama corriendo localmente (puerto 11434)
#    - Operación 100% offline, sin envío de datos
#    - Latencia: ~2-5s (según modelo)
#
# ☁️ MODO CLOUD (Recomendado para Velocidad):
#    - Usa Groq API (requiere key)
#    - Datos enviados a servidores Groq (EEUU)
#    - Latencia: <1s
#
LLM_PROVIDER=local

# ─────────────────────────────────────────────────────────────
# OLLAMA CONFIGURATION (Local LLM)
# ─────────────────────────────────────────────────────────────
# URL del servicio Ollama
# En Docker Compose: http://ollama:11434
# En localhost: http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434

# Modelo a usar en Ollama
# Recomendado: qwen2.5-coder:7b (optimizado para código)
# Opciones: llama2, mistral, neural-chat, etc.
OLLAMA_MODEL=qwen2.5-coder:7b

# ─────────────────────────────────────────────────────────────
# GROQ CONFIGURATION (Cloud LLM - Opcional)
# ─────────────────────────────────────────────────────────────
# Tu API Key de Groq (obtén en https://console.groq.com)
# Solo requerido si LLM_PROVIDER=cloud
# ⚠️ NUNCA commitear este valor
GROQ_API_KEY=your-groq-api-key-here

# Modelo de Groq a usar
# Recomendado: llama2-70b-4096 o mixtral-8x7b-32768
GROQ_MODEL=llama2-70b-4096

# ─────────────────────────────────────────────────────────────
# CHROMADB CONFIGURATION (Vector Database)
# ─────────────────────────────────────────────────────────────
# Ruta local donde ChromaDB persiste los embeddings
# En Docker: /chroma/chroma (volumen compartido)
# En localhost: ./data/chroma
CHROMADB_PATH=/chroma/chroma

# URL del servicio ChromaDB (en Docker Compose)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Nombre de la colección de vectores
CHROMA_COLLECTION_NAME=knowledge_base

# ─────────────────────────────────────────────────────────────
# SQLITE CONFIGURATION (Relational Database)
# ─────────────────────────────────────────────────────────────
# Ruta local de la base de datos SQLite
# Usado para: sesiones de chat, historial, configuración
SQLITE_DB_PATH=/app/data/softarchitect.db

# ─────────────────────────────────────────────────────────────
# KNOWLEDGE BASE CONFIGURATION
# ─────────────────────────────────────────────────────────────
# Ruta a los Tech Packs (documentación)
# En Docker: /app/knowledge_base
# En localhost: ../../../packages/knowledge_base
KNOWLEDGE_BASE_PATH=/app/knowledge_base

# Directorio de caché para embeddings procesados
# Evita re-procesar documentos ya indexados
CACHE_DIR=/app/data/cache

# ─────────────────────────────────────────────────────────────
# CHAT HISTORY CONFIGURATION
# ─────────────────────────────────────────────────────────────
# Máximo de mensajes en el historial conversacional
# Para proyectos grandes (25+ documentos), se recomienda 100+
# Default: 100 (50 user + 50 assistant)
CHAT_MAX_HISTORY_MESSAGES=100

# Máximo de caracteres por mensaje
# El modelo soporta 32K tokens (~32000 chars)
# Se recomienda 20000 para documentos extensos
# Default: 20000
CHAT_MAX_MESSAGE_LENGTH=20000

# ─────────────────────────────────────────────────────────────
# SECURITY & PRIVACY SETTINGS
# ─────────────────────────────────────────────────────────────
# Token de API para requests autenticados (Bearer token)
# Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️ NUNCA commitear este valor
API_SECRET_KEY=your-secret-key-here

# Habilitar modo "Iron" (Paranoia Mode)
# Si True:
#  - No permite conexiones externas
#  - Todos los outputs loguean localmente
#  - Requiere confirmación explícita para usar Groq
IRON_MODE=True

# Habilitar PII (Personally Identifiable Information) filtering
# Si True: Detecta y ofusca emails, teléfonos, IP en prompts
# Recomendado: True para modo cloud
PII_DETECTION_ENABLED=True

# ─────────────────────────────────────────────────────────────
# RATE LIMITING & PERFORMANCE
# ─────────────────────────────────────────────────────────────
# Máximo de requests por minuto por IP
RATE_LIMIT_RPM=60

# Timeout de inferencia (segundos)
# Si la respuesta tarda más, se cancela
INFERENCE_TIMEOUT_SECONDS=30

# Máximo tokens en respuesta
MAX_OUTPUT_TOKENS=2048

# ─────────────────────────────────────────────────────────────
# LOGGING & MONITORING
# ─────────────────────────────────────────────────────────────
# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Habilitar logging de prompts (todos los inputs/outputs)
# ⚠️ Usable solo en modo local/offline (privacidad)
ENABLE_PROMPT_LOGGING=True

# Archivo de log
LOG_FILE=/app/logs/softarchitect.log

# ─────────────────────────────────────────────────────────────
# DOCKER COMPOSE SPECIFIC
# ─────────────────────────────────────────────────────────────
# Versiones de imágenes Docker
OLLAMA_IMAGE_VERSION=latest
CHROMADB_IMAGE_VERSION=latest
PYTHON_VERSION=3.12.3

# Límites de recursos
OLLAMA_MEMORY_LIMIT=2GB
OLLAMA_CPU_SHARES=1024
API_MEMORY_LIMIT=512MB
CHROMADB_MEMORY_LIMIT=512MB
